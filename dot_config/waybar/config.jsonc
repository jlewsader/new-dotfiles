{
  "layer": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "hyprland/submap",
    "custom/kdeconnect",
    "bluetooth",
    "network",
    "battery",
    "pulseaudio",
    "cpu",
    "memory",
    "clock"
  ],
"hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true,
    "enable-bar-scroll": true,
    "scroll-speed": 1
},

"hyprland/window": {
    "format": "{class}",
    "separate-outputs": true,
    "rewrite": {
        "firefox": "Firefox ",
        "kitty": "Terminal  ",
        "yazi": "Files ",
        "org.gnome.Nautilus": "Files ",
        "spotify": "Spotify  ",
        "^$": "Arch Linux "
    }
},
  "battery": {
    "interval": 60,
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "charging": [
        "󰢟",
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ]
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "exec kitty --title=bluetui -e bluetui"
  },
  "cpu": {
    "interval": 10,
    "format": "  {}%",
    "max-length": 10,
    "on-click": "exec kitty --title=btop -e btop"
  },
  "memory": {
    "interval": 30,
    "format": "   {percentage}%",
    "tooltip-format": "{used:0.1f}G/{total:0.1f}G used",
    "on-click": "exec kitty --title=htop -e htop"
  },
  "network": {
    "format": "",
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "󰖪",
    "max-length": 50,
    "on-click": "exec kitty --title=nmtui -e nmtui"
  },
  "clock": {
    "tooltip": true,
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%D}",
  },
  "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟 {volume}%",
      "format-icons": {
          "headphone": "󰋋",
          "hands-free": "󰋋",
          "headset": "󰋋",
          "phone": "󰏲",
          "portable": "󰏲",
          "car": "󰄋",
          "default": ["󰕿", "󰖀", "󰕾"]
      },
      "scroll-step": 2,
      "on-click": "pavucontrol",
      "reverse-scrolling": true
  },
  "custom/kdeconnect": {
      "exec": "~/.config/waybar/kdeconnect.sh",
      "return-type": "json",
      "interval": 10,
      "on-click": "kdeconnect-app"
  }
}
