# Global Defaults
Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
{{ if eq .chezmoi.os "darwin" -}}
    UseKeychain yes
{{ end -}}

# Pi (WiFi)
Host pi
    HostName 192.168.1.254
    User jlewsader
    IdentityFile ~/.ssh/id_ed25519

# Tailscale PVM
Host tailscalepvm
    HostName 192.168.1.6
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    SetEnv TERM=xterm-256color

# Proxmox Server
Host proxmox
    HostName 192.168.1.5
    User root
    IdentityFile ~/.ssh/id_ed25519
    SetEnv TERM=xterm-256color

# Immich Server
Host immich
    HostName 192.168.1.8
    User root
    IdentityFile ~/.ssh/id_ed25519
    SetEnv TERM=xterm-256color
    
# Ollama Server
Host ollama
    HostName 192.168.1.248
    User root
    IdentityFile ~/.ssh/id_ed25519
    SetEnv TERM=xterm-256color
