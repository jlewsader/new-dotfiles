[user]
    name = "Justin Lewsader"
    email = "jlewsader@gmail.com"

[core]
    editor = nvim
    pager = cat

[init]
    defaultBranch = main

[pull]
    rebase = true

[diff]
	tool = nvimdiff
[difftool]
	prompt = false

{{ if eq .chezmoi.os "darwin" -}}
[credential]
    helper = osxkeychain
{{ else -}}
[credential]
    helper = store
{{ end -}}
